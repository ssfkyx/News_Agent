# LLM API（必填）：默认 DeepSeek，也支持任意 OpenAI 兼容接口
# 可写 LLM_API_KEY，或使用兼容名称 DEEPSEEK_API_KEY / OPENAI_API_KEY
LLM_API_KEY=your_llm_api_key

# GitHub 只读 token（可选，避免 60/h 未鉴权限流）
GITHUB_TOKEN=your_github_token

# 邮件推送（已停用；Gmail 需开启两步验证并生成「应用专用密码」，不是登录密码）
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_password
